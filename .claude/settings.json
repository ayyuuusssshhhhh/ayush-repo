{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm install*)",
      "Bash(npm run build*)",
      "Bash(npx playwright install*)",
      "Bash(node browser-agent/dist/index.js*)",
      "Bash(python3 enrich_contacts.py*)"
    ]
  }
}
