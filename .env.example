# Copy this file to .env.local (or .env) and fill in real values.
# Never commit the filled-in file — .env* is gitignored.

# --- Database (Supabase Postgres) ---------------------------------------
# Pooled connection string (via Supabase's connection pooler, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct (non-pooled) connection string, port 5432. `prisma migrate` needs a direct
# connection (pgbouncer's transaction mode doesn't support the DDL Prisma migrations run) —
# run migrations with `DATABASE_URL="$DIRECT_URL" npx prisma migrate dev`.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- Supabase Auth + Storage ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only: bypasses Row Level Security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- AI provider (MVP: Anthropic only) -----------------------------------
ANTHROPIC_API_KEY="sk-ant-..."
